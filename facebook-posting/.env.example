# facebook-posting/.env.example
#
# Copy this file to facebook-posting/.env and fill in real values.
# NEVER commit .env to git (it's in .gitignore).
#
# To get a Page access token, run:
#   python3 scripts/get_page_token.py
#
# ─────────────────────────────────────────────────────────────

# Your Facebook Page's numeric ID
# Find it: Facebook Page → About → scroll to bottom → Page ID
FACEBOOK_PAGE_ID=your_page_numeric_id

# Long-lived Page access token (obtain via get_page_token.py)
# This does NOT expire as long as you don't change your FB password.
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_token_here

# ── Required only to run get_page_token.py / diagnose_token.py ───────────
# App ID: developers.facebook.com → your app → App Dashboard → App ID
FACEBOOK_APP_ID=your_app_id

# App Secret: App Dashboard → Settings → Basic → App Secret (click "Show")
FACEBOOK_APP_SECRET=your_app_secret

# ── Only needed while running get_page_token.py ──────────────────────────
# Paste a fresh short-lived User token from Graph API Explorer.
# It only lasts ~1 hour, so you only need it when refreshing.
# After running get_page_token.py, you can clear this value.
# FACEBOOK_SHORT_LIVED_USER_TOKEN=paste_short_lived_user_token_here

# fal.ai — generate Canva 16:9 backgrounds (facebook-posting/scripts/generate_fal_canva_backgrounds.mjs)
# FAL_KEY=fal_xxxxxxxx
# (Script also accepts Fal_key if you use that name in .env.local.)

# ── Optional: ad creative assets ───────────────────────────────────────────
# Base folder of background images; each subfolder = one Canva template (e.g. mom_family_02_clean).
# Prefer config/paths.local.json with canva_backgrounds_dir + active_template.
# CANVA_BACKGROUNDS_DIR=/Users/you/Desktop/Canva background images
