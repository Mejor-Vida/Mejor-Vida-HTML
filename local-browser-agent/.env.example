# Copy to .env and fill in. Do not commit .env.

# --- Browser agent LLM (pick one provider via LLM_PROVIDER) ---
LLM_PROVIDER=openai
# openai | browser_use | anthropic | google

# OpenAI (recommended for local runs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Plan button uses OpenAI Chat Completions (cheap model)
PLAN_MODEL=gpt-4o-mini

# Browser Use cloud model (if LLM_PROVIDER=browser_use)
# BROWSER_USE_API_KEY=
# BROWSER_USE_MODEL=bu-latest

# Anthropic (if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-0

# Google Gemini (if LLM_PROVIDER=google)
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-flash-latest

# Ask short clarifying questions in chat before starting the browser (requires OPENAI_API_KEY).
# SKIP_GOAL_CLARIFICATION=true
# CLARIFY_MODEL=gpt-4o-mini

# After clarification, draft a plan; it streams in the Plan preview (see PLAN_STREAM_*). Approve appears only
# if local disk/download risk is detected (plan_risk), unless you force always-approve or skip risk checks.
# SKIP_PLAN_APPROVAL=true
# PLAN_APPROVAL_MODEL=gpt-4o-mini
# PLAN_STREAM_MS=300
# PLAN_STREAM_CHARS=28
# One browser Thinking/Doing line added to chat every N ms (avoids a burst of lines in one frame).
# STEP_LOG_POLL_MS=420
# Cap finished-run result size in chat (characters); raise for longer pastes.
# RECAP_RESULT_MAX_CHARS=12000
# PLAN_RISK_MODEL=gpt-4o-mini
# Always show Approve/Cancel (ignores risk classifier).
# FORCE_PLAN_APPROVAL=true
# Never require manual Approve (treat all plans as low local risk — use with care).
# SKIP_PLAN_RISK_GATE=true

# Disable deterministic “where do you save?” FAQ in chat (default: on).
# SKIP_STORAGE_LOCATION_FAQ=true

# Optional: official Assurity Agent Center login URL injected into agent instructions (default if unset).
# ASSURITY_AGENT_LOGIN_URL=https://agentcenter.assurity.com/auth/login

# Optional tuning
# Raise for deep multi-tab research (full underwriting guides, many PDF sections). Try 80–120 if it stops early.
MAX_STEPS=60
# Set to true only on a headless server (default shows a visible window)
BROWSER_HEADLESS=false

# If Chromium never opens the CDP port in time (Connection refused / 30s timeout), raise these:
# (browser-use reads these; defaults are applied in code if unset)
# TIMEOUT_BrowserLaunchEvent=120
# TIMEOUT_BrowserStartEvent=120
# BROWSER_CDP_WAIT_SECONDS=90

# Optional: absolute path to Chrome or Chromium if auto-detection fails (macOS example):
# BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Set to 1 to disable automatic removal of stale SingletonLock (only if cleanup causes issues):
# BROWSER_SKIP_STALE_LOCK_CLEANUP=1

# --- One folder for all browser-use saves (recommended) ---
# Set this to a single folder on your Desktop (or anywhere). The app uses ONLY this tree for:
#   - downloads from websites
#   - agent write_file text files (inside …/browseruse_agent_data/ — fixed by browser-use)
#   - Chromium profile / cookies (…/chromium_profile/ by default)
# Example:
# BROWSER_USE_DOWNLOADS=/Users/you/Desktop/Browser-Use Downloads

# Only if you want the browser profile somewhere else (optional):
# BROWSER_USER_DATA_DIR=/path/to/profile

# Keep browser process alive after a task (default: true). Each run still uses a new Python process; closing the window when the run ends can still happen.
# BROWSER_KEEP_ALIVE=true
