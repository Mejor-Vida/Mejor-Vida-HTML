{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pip install -r integrations/quote_api/requirements.txt"
  },
  "deploy": {
    "startCommand": "python3 integrations/quote_api/server.py --port $PORT",
    "healthcheckPath": "/api/quote/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
