{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/julie.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"julie.vcf\""
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/nurture-cron",
      "schedule": "0,30 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/website-chat",
      "destination": "/api/rag-site"
    }
  ]
}
