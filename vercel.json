      "permanent": true
    },
    {
      "source": "/blog/unum-reaseguro-ltc-2026-07-06.html",
      "destination": "/blog/weekly-insurance-update-2026-07-12.html#story1",
      "permanent": false
    },
    {
      "source": "/blog/aumentos-primas-medigap-2026-07-08.html",
