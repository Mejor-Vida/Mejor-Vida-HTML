{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mejorvidainsurance.com" }],
      "destination": "https://www.mejorvidainsurance.com/:path*",
      "permanent": true
    },
    {
      "source": "/quote-screen",
      "destination": "/quote.html",
      "permanent": true
    },
    {
      "source": "/quote-screen.html",
      "destination": "/quote.html",
      "permanent": true
    },
    {
      "source": "/privacy-policy-en.html",
      "destination": "/en/privacy-policy.html",
      "permanent": true
    },
    {
      "source": "/privacy-policy-en",
      "destination": "/en/privacy-policy.html",
      "permanent": true
    },
    {
      "source": "/terms-service-en.html",
      "destination": "/en/terms-service.html",
      "permanent": true
    },
    {
      "source": "/terms-service-en",
      "destination": "/en/terms-service.html",
      "permanent": true
    },
    {
      "source": "/agendar-julie",
      "destination": "/schedule-julie.html",
      "permanent": true
    },
    {
      "source": "/agendar-julie.html",
      "destination": "/schedule-julie.html",
      "permanent": true
    },
    {
      "source": "/schedule",
      "destination": "/schedule-julie.html",
      "permanent": false
    },
    {
      "source": "/quote.html",
      "has": [{ "type": "query", "key": "schedule", "value": "1" }],
      "destination": "/schedule-julie.html",
      "permanent": true
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/julie.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"julie.vcf\""
        }
      ]
    },
    {
      "source": "/staff",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/staff/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/staff/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/nurture-cron",
      "schedule": "0,30 * * * *"
    },
    {
      "path": "/api/nurture-enroll-cron",
      "schedule": "5,15,25,35,45,55 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/website-chat",
      "destination": "/api/rag-site"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-service",
      "destination": "/terms-service.html"
    },
    {
      "source": "/terms",
      "destination": "/terms-service.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-service.html"
    },
    {
      "source": "/privacy-policy-en",
      "destination": "/privacy-policy-en.html"
    },
    {
      "source": "/about-julie",
      "destination": "/about-julie.html"
    },
    {
      "source": "/terms-service-en",
      "destination": "/terms-service-en.html"
    },
    {
      "source": "/sms-optin",
      "destination": "/sms-optin.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/quote",
      "destination": "/en/quote.html"
    },
    {
      "source": "/en/quote-results",
      "destination": "/en/quote-results.html"
    },
    {
      "source": "/en/about-julie",
      "destination": "/en/about-julie.html"
    },
    {
      "source": "/en/contact",
      "destination": "/en/contact.html"
    },
    {
      "source": "/en/blog",
      "destination": "/en/blog.html"
    },
    {
      "source": "/en/final-expense-estimator",
      "destination": "/en/final-expense-estimator.html"
    },
    {
      "source": "/en/landing-final-expense",
      "destination": "/en/landing-final-expense.html"
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/en/privacy-policy.html"
    },
    {
      "source": "/en/terms-service",
      "destination": "/en/terms-service.html"
    },
    {
      "source": "/en/sms-optin",
      "destination": "/en/sms-optin.html"
    },
    {
      "source": "/en/schedule-julie",
      "destination": "/en/schedule-julie.html"
    },
    {
      "source": "/en/quote-out-of-state",
      "destination": "/en/quote-out-of-state.html"
    },
    {
      "source": "/en/thank-you-out-of-state",
      "destination": "/en/thank-you-out-of-state.html"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/en/blog/:slug.html"
    },
    {
      "source": "/en/carriers/:slug",
      "destination": "/en/carriers/:slug.html"
    }
  ]
}
