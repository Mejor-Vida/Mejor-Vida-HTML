{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mejorvidainsurance.com" }],
      "destination": "https://www.mejorvidainsurance.com/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/julie.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"julie.vcf\""
        }
      ]
    },
    {
      "source": "/staff",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/staff/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/staff/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/nurture-cron",
      "schedule": "0,30 * * * *"
    },
    {
      "path": "/api/nurture-enroll-cron",
      "schedule": "5,15,25,35,45,55 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/website-chat",
      "destination": "/api/rag-site"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-service",
      "destination": "/terms-service.html"
    },
    {
      "source": "/terms",
      "destination": "/terms-service.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-service.html"
    },
    {
      "source": "/privacy-policy-en",
      "destination": "/privacy-policy-en.html"
    },
    {
      "source": "/about-julie",
      "destination": "/about-julie.html"
    },
    {
      "source": "/terms-service-en",
      "destination": "/terms-service-en.html"
    },
    {
      "source": "/sms-optin",
      "destination": "/sms-optin.html"
    }
  ]
}
