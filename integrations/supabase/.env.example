# Copy keys into repo root `.env.local` (never commit real values).

# For apply_migrations.py (Postgres from Supabase → Database → Connection string).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Server-side only (Vercel API routes — never expose in static HTML)
SUPABASE_SERVICE_ROLE_KEY=
# Alias some setups use:
# SUPABASE_SERVICE_KEY=

SUPABASE_DB_PASSWORD=

# --- Vercel: api/fex-email-quote-webhook.js (Make.com → Supabase + HubSpot) ---
# Generate secret: openssl rand -hex 32
# FEX_EMAIL_WEBHOOK_SECRET=
# HUBSPOT_FEX_PIPELINE_ID=
# HUBSPOT_FEX_DEAL_STAGE_ID=
# (Also set on Vercel: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, HUBSPOT_ACCESS_TOKEN)
