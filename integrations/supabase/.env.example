# Copy keys into repo root `.env.local` (never commit real values).

# Preferred for Postgres migrations + quote_data (URI from Supabase → Database → Connection string).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Server-side only (quote API, imports — never expose in quote.html)
SUPABASE_SERVICE_ROLE_KEY=
# Alias some setups use:
# SUPABASE_SERVICE_KEY=

SUPABASE_DB_PASSWORD=

# Which product_version to read (optional; default = active assurity / whole_life_protect_plus)
# QUOTE_DB_CARRIER_SLUG=assurity
# QUOTE_DB_PRODUCT_SLUG=whole_life_protect_plus
# QUOTE_DB_VERSION_CODE=sheet_import_v1

# Quote API: default supabase (no operational Sheet reads)
# QUOTE_DATA_SOURCE=supabase
# QUOTE_ALLOW_SHEET_FALLBACK=1
# Lead List sheet mirror after Supabase insert (default on; set 0 to disable)
# LEAD_LIST_GOOGLE_SHEET_BACKUP=0
