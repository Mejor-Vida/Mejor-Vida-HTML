# Example only — copy values into repo root `.env.local` (never commit secrets).
#
# Vercel (production website proxy): set QUOTE_API_UPSTREAM to the public origin of
# this Python API (no path), e.g. https://mvs-quote.railway.app — not in .env.local.

GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_TAB=Lead List

HUBSPOT_ACCESS_TOKEN=

MVS_SCHEDULE_CALL_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

QUOTE_API_PORT=8765
QUOTE_CORS_ORIGINS=*
QUOTE_API_SHARED_SECRET=

# Supabase (repo root .env.local): SUPABASE_URL + SUPABASE_DB_PASSWORD
# Default DSN uses session pooler (IPv4-friendly on Railway). Optional: SUPABASE_POOLER_REGION=us-west-2
# SUPABASE_USE_DIRECT_DB=1 forces db.<ref>.supabase.co (direct; may use IPv6)
