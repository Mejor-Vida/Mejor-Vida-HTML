# Copy to .env.local for local tooling (never commit secrets).

# Supabase (Vercel serverless + migrations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional alias for /api/quote only if you prefer this name in Vercel:
# SUPABASE_SERVICE_KEY=your_service_role_key
# For integrations/supabase/apply_migrations.py only:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# HubSpot private app
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# OpenAI (ManyChat RAG)
OPENAI_API_KEY=your_openai_api_key

# Staff portal Gmail integration
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=https://www.mejorvidainsurance.com/api/staff/gmail-callback
GMAIL_REFRESH_TOKEN=your_google_refresh_token
GMAIL_FROM_EMAIL=julie@mejorvidainsurance.com
# Optional: override Facebook review link in staff review-request emails (default: Mejor Vida Facebook reviews page)
# FACEBOOK_REVIEW_URL=https://www.facebook.com/MejorVidaInsurance/reviews
# Optional: comma-separated recipients when a client submits medical intake (default: admin + julie)
# MEDICAL_INTAKE_NOTIFY_TO=admin@mejorvidainsurance.com, julie@mejorvidainsurance.com

# Optional: include token usage on POST /api/website-chat JSON (embedding + gpt-4o-mini). Default off.
# Server always logs one line per RAG request: search Vercel logs for "rag_request_usage".
# RAG_RETURN_USAGE=1

# ManyChat External Request — send header X-App-Secret with this value
MANYCHAT_WEBHOOK_SECRET=your_webhook_secret

# Optional: Make.com custom webhook URL — confirmacion page can forward booking payload
MAKE_APPOINTMENT_WEBHOOK_URL=https://hook.us1.make.com/your-scenario-id

# Facebook first comment — scheduled ~10 min after publish (facebook-posting/main.py)
# MAKE_FB_FIRST_COMMENT_WEBHOOK_URL=https://hook.us2.make.com/your-scenario-id

# Meta Conversions API — server-side Lead on gastos-finales-ads-v2 quote submit (api/quote-lead-sync.js)
# Pixel / dataset ID 873141755808233. Generate in Meta Events Manager → Settings → Conversions API.
# META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token

# Browser-only routes /api/quote-site and /api/rag-site — comma-separated allowed origins (optional)
# On Vercel, https://$VERCEL_URL plus the request Host (*.vercel.app) are allowed (see lib/site-origin.js).
# WEBSITE_ALLOWED_ORIGINS=https://www.mejorvidainsurance.com,https://mejorvidainsurance.com

# Out-of-state referral form (quote-out-of-state.html → api/out-of-state-referral.js)
# Deploy integrations/google-apps-script/out-of-state-referral-email.gs as a web app; paste URL here.
# OOS_EMAIL_NOTIFIER_URL=https://script.google.com/macros/s/.../exec
# Optional shared secret (same value as Apps Script project setting Script property OOS_SECRET)
# OOS_EMAIL_NOTIFIER_SECRET=your_random_secret

# ManyChat REST API — Bearer token used by:
#   - api/nurture-cron.js (sendFlow, Phase 1 WhatsApp)
#   - api/lead-intake.js  (subscriber/getInfo pull — fetches profile + custom_fields
#                          for a subscriber_id so ManyChat External Requests can send
#                          just `{ "subscriber_id": "{{id}}" }`)
# MANYCHAT_API_KEY=your_page_id:your_api_key

# ── Nurture Pipeline: ManyChat Flow IDs (Phase 1 WhatsApp — 2 steps only) ─────
# Flow namespace: ManyChat flow → ⋮ → Flow namespace. No STEP3 or STEP4.
# Immediate post-quote email is /api/post-quote-email (not WhatsApp).
# WA Step 1: 5 hours after enrollment (lead-intake sets next_send_at = now + 5h)
MANYCHAT_FLOW_PHASE1_STEP1=content20260414115052_091445
# WA Step 2: 21 hours after enrollment
MANYCHAT_FLOW_PHASE1_STEP2=content20260414115456_756698

# ── Outbound SMS: Telnyx (10DLC C18HVT1, +14028441199) ───────────────────────
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_SMS_FROM=+14028441199
# Optional: messaging profile UUID as `from` (recommended for 10DLC replies)
TELNYX_MESSAGING_PROFILE_ID=40019ee2-08d6-4ab1-9af2-ed6a2be30543
# Optional: ?secret= on inbound webhook URL (see integrations/TELNYX_SMS_SETUP.md)
TELNYX_WEBHOOK_SECRET=your_random_webhook_secret

# Landing phone SMS OTP (/api/phone-verify) — Telnyx via lib/sms-send.js
# PHONE_VERIFY_OTP_SECRET=   # openssl rand -hex 32 (falls back to CRON_SECRET)

# ── Nurture Pipeline: Resend (Phase 3 Email) ──────────────────────────────────
RESEND_API_KEY=your_resend_api_key
# Sender must be a verified domain in Resend: julie@mejorvidainsurance.com
# HTML shell + signatures for transactional mail: lib/resend-email-template.js

# ── Cron authentication (Vercel Cron → /api/nurture-cron) ────────────────────
CRON_SECRET=your_random_cron_secret   # generate: openssl rand -hex 32

# RAG knowledge ingestion (scripts/ingest_knowledge_to_supabase.py)
# GOOGLE_SHEETS_AI_KNOWLEDGE_SPREADSHEET_ID=your_sheet_id_from_the_url
# GOOGLE_SHEETS_AI_KNOWLEDGE_GID=0
# Optional: private sheet via service account (share sheet with SA email as Viewer)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Website chatbot uses text only; ElevenLabs TTS is not wired in the UI.
# If you add api/elevenlabs-tts.js again: set ELEVENLABS_API_KEY and ELEVENLABS_VOICE_ID in Vercel.
